# Paste these into each app after Postgres is running on the VPS.
# Replace YOUR_PASSWORD with POSTGRES_PASSWORD from infrastructure/postgres/.env
#
# Apps on the VPS host (PM2 / systemd — same machine as Docker):
DATABASE_URL="postgresql://nuvisa:YOUR_PASSWORD@127.0.0.1:5432/nuvisa"
DIRECT_URL="postgresql://nuvisa:YOUR_PASSWORD@127.0.0.1:5432/nuvisa"
DATABASE_SSL=false
#
# Apps in Docker on the same compose network (future full stack):
# DATABASE_URL="postgresql://nuvisa:YOUR_PASSWORD@postgres:5432/nuvisa"
# DIRECT_URL="postgresql://nuvisa:YOUR_PASSWORD@postgres:5432/nuvisa"
# DATABASE_SSL=false
