# Copy to .env and fill in values

PORT=4000
APP_ENV=development
env=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DATABASE_SSL=true

JWT_SECRET=change-me

WEBSITE_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:4000
ALLOW_ORIGIN_NOAUTH=http://localhost:3001,http://localhost:3002

SMTP_HOST=mail.privateemail.com
# Optional: use when local DNS times out (queryA ETIMEOUT) — run: nslookup mail.privateemail.com
# SMTP_HOST_IP=
# Optional: comma-separated DNS servers for SMTP hostname resolution
# SMTP_DNS_SERVERS=8.8.8.8,1.1.1.1
SMTP_PORT=587
SMTP_USER=support@nuvisa.co.uk
SMTP_PASS=
MAILER_EMAIL=support@nuvisa.co.uk
MAILER_FROM_EMAIL=support@nuvisa.co.uk
MAILER_SMTP_PASSWORD=

API_SERVER=https://api.qa.stampmyvisa.com
API_VERSION=v1
CLIENT_ID=
CLIENT_SECRET=

# sk_test_… from Stripe Dashboard → Developers → API keys (pair with pk_test_ on frontend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

HETZNER_S3_ENDPOINT=
HETZNER_S3_REGION=eu-central
HETZNER_S3_BUCKET_NAME=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=

FEEDBACK_NOTIFY_EMAIL=support@nuvisa.co.uk
